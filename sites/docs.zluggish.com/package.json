{
  "name": "@zluggish/docs",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.22 <25"
  },
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "package": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../scripts/build-cf-output.mjs",
    "deploy:dry-run": "pnpm build && pnpm package && cf deploy --prebuilt --dry-run",
    "deploy": "pnpm build && pnpm package && cf deploy --prebuilt",
    "deploy:preview": "pnpm build && pnpm package --preview && cf previews deploy --prebuilt"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/montserrat": "5.2.8",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "cf": "1.0.0-beta.32",
    "typescript": "6.0.3"
  }
}
